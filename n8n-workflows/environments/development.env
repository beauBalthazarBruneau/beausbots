# n8n Development Environment Configuration

# Basic n8n settings
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# Webhook settings (will be updated with ngrok URL)
WEBHOOK_URL=http://localhost:5678

# Authentication (for development)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=beausbots2025

# Database (SQLite for development)
DB_TYPE=sqlite
DB_SQLITE_DATABASE=/Users/beaubruneau/Documents/beausbots/n8n-workflows/.n8n/database.sqlite

# Logging
N8N_LOG_LEVEL=debug

# Local MCP integration
LOCAL_MCP_URL=http://localhost:3000

# API Keys (add your actual keys)
LINEAR_API_KEY=your_linear_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GITHUB_TOKEN=your_github_token_here
