{
  "name": "@beausbots/project-manager-mcp",
  "version": "1.0.0",
  "description": "Simple MCP server for project context management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & nodemon --watch dist dist/index.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "setup": "npm install && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "project-management",
    "claude"
  ],
  "author": "Beau Bruneau",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
